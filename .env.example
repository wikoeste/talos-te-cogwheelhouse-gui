# Confluence Team Calendar integration
CONFLUENCE_CALENDAR_URL=https://confluence.vrt.sourcefire.com/plugins/servlet/team-calendars/caldav/0fe61231-e3fb-435b-905e-e9c4d4be5ee5
CONFLUENCE_CALENDAR_USERNAME=
CONFLUENCE_CALENDAR_API_TOKEN=
CONFLUENCE_CALENDAR_MODE=caldav
CONFLUENCE_CALENDAR_AUTH_MODE=bearer
CONFLUENCE_CALENDAR_VERIFY_TLS=true
CONFLUENCE_CALENDAR_ALLOWED_HOST=confluence.vrt.sourcefire.com
CONFLUENCE_CALENDAR_WEB_URL=https://confluence.vrt.sourcefire.com/display/TET/calendar/0fe61231-e3fb-435b-905e-e9c4d4be5ee5?calendarName=Talos%20Escalations%20Team%20Calendar
TEAM_CALENDAR_TIMEZONE=America/New_York

# SI Category Details used by the WBRS Feeds expiration column.
# Reuses CONFLUENCE_CALENDAR_API_TOKEN above for read-only API access.
CONFLUENCE_SI_CATEGORY_API_URL=https://confluence.vrt.sourcefire.com/rest/api/content/161428515
CONFLUENCE_SI_CATEGORY_PAGE_URL=https://confluence.vrt.sourcefire.com/spaces/TET/pages/161428515/SI+Category+Details

# Application secrets. Generate unique values; never commit populated secrets.
FLASK_SECRET_KEY=
BP_GITHUB_TOKEN=
ACE_DB_HOST=ava-tdbro-01prd.vrt.sourcefire.com
ACE_DB_NAME=analyst_console
ACE_DB_USER=ace_ro
ACE_DB_PASSWORD=
THREATGRID_API_KEY=

# Local server settings.
COGWHEELHOUSE_HOST=127.0.0.1
COGWHEELHOUSE_PORT=8000
FLASK_DEBUG=false

# Short-lived server-side staging for optional replay-result Jira comments.
REPLAY_POST_STATE_DIR=
REPLAY_POST_TTL_SECONDS=1800
REPLAY_POST_MAX_CHARS=200000
JIRA_POST_MAX_COMMENT_CHARS=30000

# CVE CR Analysis API. Keep the API key only in the local environment.
CR_LOOKUP_URL=https://analysis-api.vrt.sourcefire.com/vulnerability/cve
ANALYSIS_API_KEY=
ANALYSIS_API_CA_BUNDLE=
CR_LOOKUP_TIMEOUT_SECONDS=20
CR_LOOKUP_MAX_RESPONSE_MB=2
CR_LOOKUP_MAX_CVES=25
CR_LOOKUP_WORKERS=5

# talos-te-bpsearch integrations. Keep credentials in the local environment.
BPSEARCH_MOAEC_URL=
BPSEARCH_MOAEC_USERNAME=
BPSEARCH_MOAEC_PASSWORD=
BPSEARCH_CLOUD_IOC_URL=
BPSEARCH_CLOUD_IOC_AUTHORIZATION=
BPSEARCH_INTEL_API_URL=https://intel.api.sourcefire.com/
BPSEARCH_INTEL_API_KEY=
